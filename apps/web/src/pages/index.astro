---
import BaseLayout from "../layouts/BaseLayout.astro";
import StageLeaderboard from "../components/StageLeaderboard";
import leaderboard from "../../public/data/leaderboard.json";
import dataStatus from "../../public/data/data-status.json";
import backtest from "../../public/data/backtest/index.json";

const latestDate = leaderboard?.latestDate ?? "暂无数据";
const updateIso = dataStatus?.generatedAt ?? dataStatus?.lastSuccessAt;
const updatedAt = updateIso
  ? new Date(updateIso).toLocaleString("sv-SE", { timeZone: "Asia/Shanghai" }).slice(0, 16)
  : null;

const availableWindows = backtest?.windows?.filter((item) => item.available) ?? [];
const shortLabel = (label: string) => label.replace(/^近\s*/, "");
const sortedWindows = [...availableWindows].sort(
  (a, b) => (a.tradingDays ?? a.minTradingDays ?? 0) - (b.tradingDays ?? b.minTradingDays ?? 0)
);
const windowRange =
  sortedWindows.length >= 2
    ? `${shortLabel(sortedWindows[0].label)} ~ ${shortLabel(sortedWindows[sortedWindows.length - 1].label)}`
    : "2 周 ~ 12 个月";
const poolStats = backtest?.poolStats;
---
<BaseLayout title="韭菜圈 | A 股条件单工具箱">
  <section class="mx-auto grid max-w-6xl gap-8 px-4 py-10 lg:grid-cols-[1.05fr_0.95fr] lg:py-16">
    <div class="flex flex-col justify-center">
      <p class="mb-4 text-sm font-semibold text-leaf">A 股 ETF/股票条件单辅助工具</p>
      <h1 class="max-w-3xl text-4xl font-bold leading-tight md:text-6xl">把盘前计划变成可执行的条件单。</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-stone-700">
        先用归档数据回测历史表现，再把盘前计划落成可执行的条件单，减少临盘情绪化操作。
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/tools/backtest" class="inline-flex min-h-[44px] items-center rounded-md bg-leaf px-5 py-3 font-semibold text-white shadow-sm hover:bg-emerald-800">查看历史回测</a>
        <a href="/tools/condition-order" class="inline-flex min-h-[44px] items-center rounded-md border border-line bg-white px-5 py-3 font-semibold hover:border-leaf">打开条件单计算器</a>
        <a href="/strategies/condition-order" class="inline-flex min-h-[44px] items-center text-sm font-semibold text-leaf hover:underline">查看策略说明</a>
      </div>
    </div>
    <div class="rounded-lg border border-line bg-white p-5 shadow-sm">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
        <p class="font-semibold">今日工具台</p>
        <span class="rounded-full bg-leaf/15 px-3 py-1 text-xs font-semibold text-leaf">当前能力</span>
      </div>
      <div class="grid gap-3">
        <a href="/tools/backtest" class="block rounded-md border border-line p-4 hover:border-leaf">
          <p class="text-sm text-stone-600">历史回测</p>
          <p class="mt-1 text-lg font-bold leading-7">选标的与区间，查看胜率、收益率、最大回撤</p>
          <p class="mt-2 text-xs leading-5 text-stone-500">仅历史统计，不代表未来收益</p>
        </a>
        <a href="/tools/condition-order" class="block rounded-md border border-line p-4 hover:border-leaf">
          <p class="text-sm text-stone-600">次日条件单</p>
          <p class="mt-1 text-lg font-bold leading-7">计算低吸价 / 高抛价，复制到券商</p>
        </a>
      </div>
      <div class="mt-4 rounded-md bg-rice p-4 text-sm leading-6">
        <p class="font-semibold">数据状态</p>
        <p class="mt-1 text-stone-700">
          最新交易日 {latestDate}{updatedAt ? ` · 更新于 ${updatedAt}` : ""}
        </p>
        {poolStats && (
          <p class="mt-1 text-stone-600">
            当前覆盖 {poolStats.total} 只标的（ETF {poolStats.etf} · 个股 {poolStats.stock}），回测覆盖 {windowRange}。
          </p>
        )}
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-4 pb-6">
    <div class="mb-4 flex items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold text-leaf">每日更新</p>
        <h2 class="mt-1 text-2xl font-bold md:text-3xl">阶段排行榜</h2>
        <p class="mt-2 text-sm leading-6 text-stone-600">个股、ETF、板块，近 1 周到今年来涨跌幅一目了然，快速看清市场主线。</p>
      </div>
    </div>
    <div class="mx-auto max-w-2xl">
      <StageLeaderboard client:load />
    </div>
  </section>
  <section class="bg-white/55">
    <div class="mx-auto grid max-w-6xl gap-4 px-4 py-10 md:grid-cols-3">
      <article class="rounded-lg border border-line bg-white p-5">
        <h2 class="text-lg font-bold">自动行情</h2>
        <p class="mt-3 leading-7 text-stone-700">后台脚本参考既有 stock/ETF 行情脚本，定时生成前端可读取的数据文件。</p>
      </article>
      <article class="rounded-lg border border-line bg-white p-5">
        <h2 class="text-lg font-bold">纪律交易</h2>
        <p class="mt-3 leading-7 text-stone-700">输出可复制的条件单文案，让交易计划在开盘前完成。</p>
      </article>
      <article class="rounded-lg border border-line bg-white p-5">
        <h2 class="text-lg font-bold">稳步变现</h2>
        <p class="mt-3 leading-7 text-stone-700">先验证复用和早鸟会员，再决定小程序、广告和完整会员系统。</p>
      </article>
    </div>
  </section>
</BaseLayout>
